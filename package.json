{
  "name": "map-json-by-json",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "Template-driven declarative JSON transformation engine where the target template is the source of truth.",
  "main": "index.js",
  "module": "./src/index.js",
  "browser": "./src/v2/browser.js",
  "bin": {
    "map-json-by-json": "./bin/map-json-by-json.js"
  },
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    },
    "./v2": "./src/v2/index.js",
    "./browser": "./src/v2/browser.js",
    "./global": "./src/v2/global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/v2",
    "bin",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/map.test.js",
    "test:v2": "node --test test/map.test.js",
    "docs:serve": "node scripts/serve-docs.js"
  },
  "keywords": [
    "map-json-by-json",
    "json-mapper",
    "json-template",
    "json-transform",
    "etl",
    "json-schema"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/map-json-by-json.git"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/map-json-by-json/issues"
  },
  "homepage": "https://github.com/keshavsoft/map-json-by-json#readme"
}
